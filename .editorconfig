root = true

# 默认配置
[*]

# 使用空格缩进
indent_style = space

# tab 键宽度和缩进大小为 4 个空格
tab_width = 4
indent_size = 4

# 使用 UTF-8 编码
charset = utf-8

# 以 LF 作为换行符
end_of_line = lf

# 在文件末尾插入一个换行符
insert_final_newline = true

# 去除行尾空格
trim_trailing_whitespace = true

# Windows 批处理文件
[*.bat]

# 使用 CRLF 作为换行符
end_of_line = crlf

# C# 项目相关
[*.{csproj,props,slnx}]

# tab 键宽度和缩进大小为 2 个空格
tab_width = 2
indent_size = 2

# Json 文件
[*.json]

# tab 键宽度和缩进大小为 2 个空格
tab_width = 2
indent_size = 2

# GitHub Actions workflows
[*.yml]

# tab 键宽度和缩进大小为 2 个空格
tab_width = 2
indent_size = 2

# 前端文件
[*.{css,html,js,ts,vue}]

# tab 键宽度和缩进大小为 2 个空格
tab_width = 2
indent_size = 2
